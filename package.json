{
  "name": "hot-update-simulator",
  "version": "1.0.0",
  "description": "游戏热更新服务端模拟器：可视化、可配置、带 API，用于复现弱网、断流、损坏等真实故障",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "sample": "node scripts/make-sample-assets.js",
    "build": "cd frontend && npm run build",
    "dev:web": "cd frontend && npm run dev",
    "smoke": "node scripts/smoke-test.js",
    "ui-check": "node scripts/ui-check.js"
  },
  "keywords": [
    "hot-update",
    "unity",
    "assetbundle",
    "simulator",
    "network",
    "chaos"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "serve-index": "^1.9.2",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
