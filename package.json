{
  "name": "hot-update-simulator",
  "version": "2.6.4",
  "description": "游戏热更新服务端模拟器：可视化、可配置、带 API，用于复现弱网、断流、损坏等真实故障",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "sample": "node scripts/make-sample-assets.js",
    "build": "cd frontend && npm run build",
    "dev:web": "cd frontend && npm run dev",
    "test": "node scripts/run-all-checks.js",
    "shots": "node scripts/make-screenshots.js",
    "smoke": "node scripts/smoke-test.js",
    "regression": "node scripts/regression-test.js",
    "lint": "eslint .",
    "ui-check": "node scripts/ui-check.js",
    "arch": "node scripts/arch-report.js",
    "soak": "node --expose-gc scripts/soak-test.js",
    "docs-check": "node scripts/docs-coverage.js",
    "version-check": "node scripts/version-check.js",
    "bump": "node scripts/bump-version.js",
    "release": "node scripts/make-release.js"
  },
  "keywords": [
    "hot-update",
    "unity",
    "assetbundle",
    "simulator",
    "network",
    "chaos",
    "fault-injection",
    "weak-network",
    "game-server",
    "testing-tool"
  ],
  "author": "JokeVallen (https://github.com/JokeVallen)",
  "license": "MIT",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JokeVallen/hot-update-simulator.git"
  },
  "homepage": "https://github.com/JokeVallen/hot-update-simulator#readme",
  "bugs": {
    "url": "https://github.com/JokeVallen/hot-update-simulator/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "serve-index": "^1.9.2",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "nodemon": "^3.1.14"
  }
}
